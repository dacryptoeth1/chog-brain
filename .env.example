# Copy to .env for local use (never commit .env). On Vercel, set these in Project Settings -> Environment Variables.

# Optional: Claude narrates the duels. Without it, a built-in commentator is used.
ANTHROPIC_API_KEY=

# Optional: override the narrator model
# NARRATOR_MODEL=claude-haiku-5-5

# Optional: permanent progress storage (Upstash Redis). Vercel adds these two for you when you
# connect Upstash from the Storage tab; the UPSTASH_REDIS_REST_* names also work.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional: a different Monad RPC, or other IPFS gateways (comma separated)
# MONAD_RPC=https://rpc.monad.xyz
# IPFS_GATEWAYS=https://ipfs.io/ipfs/,https://dweb.link/ipfs/
